{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"paths": {
			"*": ["./*"],
			"@blastpepsi1-eng/lokai-ai": ["./packages/ai/src/index.ts"],
			"@blastpepsi1-eng/lokai-ai/oauth": ["./packages/ai/src/oauth.ts"],
			"@blastpepsi1-eng/lokai-ai/*": ["./packages/ai/src/*.ts", "./packages/ai/src/providers/*.ts"],
			"@blastpepsi1-eng/lokai-ai/dist/*": ["./packages/ai/src/*"],
			"@blastpepsi1-eng/lokai-agent-core": ["./packages/agent/src/index.ts"],
			"@blastpepsi1-eng/lokai-agent-core/*": ["./packages/agent/src/*"],
			"@blastpepsi1-eng/lokai-coding-agent": ["./packages/coding-agent/src/index.ts"],
			"@blastpepsi1-eng/lokai-coding-agent/hooks": ["./packages/coding-agent/src/core/hooks/index.ts"],
			"@blastpepsi1-eng/lokai-coding-agent/*": ["./packages/coding-agent/src/*"],
			"typebox": ["./node_modules/typebox"],
			"@blastpepsi1-eng/lokai-mom": ["./packages/mom/src/index.ts"],
			"@blastpepsi1-eng/lokai-mom/*": ["./packages/mom/src/*"],
			"@blastpepsi1-eng/lokai": ["./packages/pods/src/index.ts"],
			"@blastpepsi1-eng/lokai/*": ["./packages/pods/src/*"],
			"@blastpepsi1-eng/lokai-tui": ["./packages/tui/src/index.ts"],
			"@blastpepsi1-eng/lokai-tui/*": ["./packages/tui/src/*"],
			"@blastpepsi1-eng/lokai-web-ui": ["./packages/web-ui/src/index.ts"],
			"@blastpepsi1-eng/lokai-web-ui/*": ["./packages/web-ui/src/*"],
			"@mariozechner/pi-agent-old": ["./packages/agent-old/src/index.ts"],
			"@mariozechner/pi-agent-old/*": ["./packages/agent-old/src/*"]
		}
	},
	"include": ["packages/*/src/**/*", "packages/*/test/**/*", "packages/coding-agent/examples/**/*"],
	"exclude": ["packages/web-ui/**/*", "**/dist/**"]
}
